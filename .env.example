# ── Server ────────────────────────────────────────────────────
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgres://afrisinc:password@localhost:5432/afrisinc_assets?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFE=30m

# ── Storage ───────────────────────────────────────────────────
# Driver: "local" or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/uploads
ASSET_BASE_URL=https://assets.afrisinc.com

# S3 / MinIO / Backblaze (only needed if STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=afrisinc-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_USE_SSL=true

# ── Auth ──────────────────────────────────────────────────────
# Generate a strong key: openssl rand -hex 32
API_KEY=replace-me-with-a-strong-random-key

# ── Upload ────────────────────────────────────────────────────
UPLOAD_MAX_MB=50
